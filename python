from datetime import datetime
from fastapi import FastAPI, UploadFile, File, Form, Depends
from fastapi.middleware.cors import CORSMiddleware
from fastapi.staticfiles import StaticFiles
from fastapi.responses import FileResponse
from pydantic import BaseModel
from sqlalchemy import create_engine, Column, String, Boolean, JSON, DateTime
from sqlalchemy.orm import declarative_base, sessionmaker, Session
import uuid
import shutil
import os

DATABASE_URL = os.getenv("DATABASE_URL", "sqlite:///./daymark.db")
connect_args = {"check_same_thread": False} if DATABASE_URL.startswith("sqlite") else {}

engine = create_engine(DATABASE_URL, connect_args=connect_args)
SessionLocal = sessionmaker(bind=engine, autoflush=False, autocommit=False)
Base = declarative_base()

app = FastAPI(title="Daymark Planner API", version="2.0.0")
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)


def get_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()


class TaskModel(Base):
    __tablename__ = "tasks"
    id = Column(String, primary_key=True, default=lambda: str(uuid.uuid4()))
    user_id = Column(String, index=True)
    workspace_id = Column(String, nullable=True, index=True)
    date = Column(String, index=True)
    title = Column(String, nullable=False)
    status = Column(String, default="pending")
    priority = Column(String, default="medium")
    revision = Column(Boolean, default=False)
    revision_offsets = Column(JSON, default=list)
    created_at = Column(DateTime, default=datetime.utcnow)


class SharedBookModel(Base):
    __tablename__ = "shared_books"
    id = Column(String, primary_key=True, default=lambda: str(uuid.uuid4()))
    title = Column(String, nullable=False)
    author = Column(String, default="")
    exam = Column(String, index=True)
    subject = Column(String)
    pdf_url = Column(String, nullable=False)
    uploaded_by = Column(String, default="Student")


class KotaHiringModel(Base):
    __tablename__ = "kota_hiring"
    id = Column(String, primary_key=True, default=lambda: str(uuid.uuid4()))
    listing_type = Column(String, index=True)  # "candidate" or "employer"
    name = Column(String, nullable=False)
    area = Column(String, default="Kota, Rajasthan")
    role_or_skills = Column(String)
    pay_or_stipend = Column(String)
    phone = Column(String, nullable=False)


Base.metadata.create_all(bind=engine)
os.makedirs("uploads", exist_ok=True)
app.mount("/uploads", StaticFiles(directory="uploads"), name="uploads")


class CoachingSyncPayload(BaseModel):
    user_id: str
    institute: str
    batch_code: str
    portal_url: str


@app.get("/api/health")
def health_check():
    return {"ok": True, "service": "daymark", "time": datetime.utcnow().isoformat()}


@app.post("/api/coaching/sync")
def sync_coaching_app(payload: CoachingSyncPayload):
    return {
        "ok": True,
        "institute": payload.institute,
        "batch_code": payload.batch_code,
        "portal_url": payload.portal_url,
        "synced_at": datetime.utcnow().isoformat(),
        "lectures": [
            {"title": f"{payload.institute} Live Lecture + DPP", "subject": "Physics"},
            {"title": f"{payload.batch_code} Practice Sheet", "subject": "Chemistry"},
        ],
    }


@app.post("/api/books/upload")
async def upload_study_pdf(
    title: str = Form(...),
    exam: str = Form(...),
    subject: str = Form(...),
    author: str = Form(""),
    uploaded_by: str = Form("Student"),
    file: UploadFile = File(...),
    db: Session = Depends(get_db),
):
    safe_name = f"{uuid.uuid4()}_{os.path.basename(file.filename or 'book.pdf')}"
    dest = os.path.join("uploads", safe_name)
    with open(dest, "wb") as buffer:
        shutil.copyfileobj(file.file, buffer)

    book = SharedBookModel(
        title=title,
        author=author,
        exam=exam,
        subject=subject,
        pdf_url=f"/uploads/{safe_name}",
        uploaded_by=uploaded_by,
    )
    db.add(book)
    db.commit()
    db.refresh(book)
    return {"ok": True, "book": {"id": book.id, "title": book.title, "pdf_url": book.pdf_url}}


@app.get("/")
def serve_frontend():
    if os.path.exists("index.html"):
        return FileResponse("index.html")
    return {"message": "Daymark API running."}
